{
  "expo": {
    "name": "משמרות",
    "slug": "DuduApp",
    "scheme": "duduapp",
    "version": "1.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.duduapp.shifts",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he",
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": ["he"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "dark": {
            "backgroundColor": "#15171B"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "ShiftsWidget",
              "displayName": "משמרות",
              "description": "המשמרת הבאה, היום ומחר והימים הקרובים",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["he"]
          },
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "בחירת תמונה של סדר העבודה לזיהוי המשמרות של דודו.",
          "cameraPermission": "צילום סדר העבודה לזיהוי המשמרות של דודו.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.duduapp.shifts.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.duduapp.shifts"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "df7c9da1-09e9-4a7c-9a3f-2ba5808a27e3"
      }
    }
  }
}
